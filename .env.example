# Application
RADIO_ATLAS_ENV=development
RADIO_ATLAS_LOG_LEVEL=INFO

# Backend application (running directly on your Mac)
RADIO_ATLAS_DATABASE_URL=postgresql+psycopg://radio_atlas:change-me@localhost:5432/radio_atlas
RADIO_ATLAS_REDIS_URL=redis://localhost:6379/0

# External providers
NOAA_BASE_URL=https://services.swpc.noaa.gov
PSK_REPORTER_BASE_URL=

# Docker Compose variables
POSTGRES_USER=radio_atlas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=radio_atlas
POSTGRES_PORT=5432

REDIS_PORT=6379
API_PORT=8000

# Deployment (origins are a JSON array of exact browser origins)
RADIO_ATLAS_CORS_ORIGINS=["http://localhost:5173"]
RADIO_ATLAS_AGGREGATION_ENABLED=false
RUN_MIGRATIONS_ON_START=true
